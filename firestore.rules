rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function isValidAffiliationsArray(affiliations) {
      return affiliations.size() <= 8;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && (!('affiliations' in request.resource.data) || isValidAffiliationsArray(request.resource.data.affiliations));
      allow update: if isOwner(userId)
        && (!changedKeys().hasAny(['affiliations']) || isValidAffiliationsArray(request.resource.data.affiliations));
      allow delete: if isOwner(userId);

      match /notifications/{notificationId} {
        allow read: if isOwner(userId)
          || (isAuthenticated() && resource.data.fromUserId == request.auth.uid);
        allow create: if isAuthenticated();
        allow update: if isOwner(userId)
          || (isAuthenticated() && resource.data.fromUserId == request.auth.uid);
        allow delete: if isOwner(userId)
          || (isAuthenticated() && resource.data.fromUserId == request.auth.uid);
      }

      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /rants/{rantId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        || (isAuthenticated() && changedKeys().hasOnly(['voterIds', 'karma', 'replyCount']));
      allow delete: if isOwner(resource.data.userId);

      match /votes/{voteId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == voteId;
        allow delete: if isAuthenticated()
          && (request.auth.uid == voteId || request.auth.uid == resource.data.userId);
      }

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isOwner(resource.data.userId)
          || (isAuthenticated() && changedKeys().hasOnly(['voterIds', 'karma']));
        allow delete: if isOwner(resource.data.userId);

        match /votes/{voteId} {
          allow read: if true;
          allow create: if isAuthenticated() && request.auth.uid == voteId;
          allow delete: if isAuthenticated()
            && (request.auth.uid == voteId || request.auth.uid == resource.data.userId);
        }
      }
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }

    // CollectionGroup queries for user's replies
    match /{path=**}/replies/{replyId} {
      allow read: if true;
    }

    // CollectionGroup queries for user's votes
    match /{path=**}/votes/{voteId} {
      allow read: if true;
    }

    // CollectionGroup query support: notifications (inbox + avatar sync)
    match /{path=**}/notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.fromUserId == request.auth.uid);
    }
  }
}
